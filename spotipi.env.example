# Template for spotipi.env (read by compose.yaml as env_file; spotipi.env is git-ignored).
# cp spotipi.env.example spotipi.env && chmod 600 spotipi.env

# Required: without it the key is regenerated on every start and all browser sessions are dropped.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Timezone for alarm, sleep timer and scheduler (code fallback: Europe/Vienna)
SPOTIPI_TIMEZONE=Europe/Vienna

# Spotify credentials: preferably enter them in the Settings UI (stored in data/secrets/.env).
# Alternatively set them here; the file in data/secrets/.env takes precedence.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_USERNAME=
# SPOTIFY_REFRESH_TOKEN=

# OAuth callback as registered in the Spotify Developer Dashboard. If unset it is built from the
# address you open the app with, e.g. http://192.168.1.50:5000/api/settings/spotify/oauth/callback
# SPOTIPI_SPOTIFY_REDIRECT_URI=

# A Pi 5 has headroom: low-power mode off, more concurrency than on the Pi Zero W.
SPOTIPI_LOW_POWER=0
SPOTIPI_MAX_CONCURRENCY=4
SPOTIPI_WAITRESS_THREADS=4

# Structured JSON logs for docker logs
SPOTIPI_JSON_LOGS=1

# Optional: access protection outside your own LAN (see Readme, section Configuration)
# SPOTIPI_ADMIN_USERNAME=spotipi
# SPOTIPI_ADMIN_PASSWORD=
